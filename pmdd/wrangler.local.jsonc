{
  // Local-dev config: identical to wrangler.jsonc but WITHOUT the AI binding,
  // so `wrangler dev` runs fully offline (the AI binding requires a remote
  // proxy session). Use: npx wrangler dev --config wrangler.local.jsonc
  // This also exercises the app's no-AI graceful-degradation path.
  "name": "pmdd",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/calendar.ics"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pmdd_db",
      "database_id": "ce0b12ed-6348-4d3f-964a-15c5ef8f85de"
    }
  ],
  "vars": {
    "TIMEZONE": "America/Chicago"
  }
}
