{
  // PMDD protocol tracker — standalone Worker, deployed separately from the 8s app.
  "name": "pmdd",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/calendar.ics"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pmdd_db",
      "database_id": "ce0b12ed-6348-4d3f-964a-15c5ef8f85de"
    }
  ],
  "vars": {
    "TIMEZONE": "America/Chicago"
  }
  // Secrets (wrangler secret put):
  //   ACCESS_KEY — shared-link key. All routes fail closed (503) when unset.
}
